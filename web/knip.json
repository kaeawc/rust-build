{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/routes/**/*.tsx",
    "scripts/*.ts",
    "test/**/*.test.{ts,tsx}",
    "e2e/**/*.spec.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "test/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "e2e/**/*.ts"
  ],
  "ignore": [
    "src/components/ui/**",
    "src/lib/utils.ts"
  ],
  "ignoreDependencies": [
    "tw-animate-css",
    "shadcn",
    "@fontsource-variable/geist",
    "tailwindcss"
  ],
  "ignoreExportsUsedInFile": true
}
