{
  "name": "rb-web",
  "version": "0.0.0",
  "private": true,
  "description": "rust-build web UI: React SPA embedded in `rb serve` (crates/rb-web).",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": ">=1.4.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun scripts/precompress.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "lint:types": "eslint --max-warnings 0 -c eslint.typechecked.config.mjs src test",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "coverage:check": "bun scripts/check-coverage-thresholds.ts",
    "dead-code": "knip",
    "e2e": "playwright test",
    "validate": "bun run lint && bun run lint:types && bun run typecheck && bun run test:coverage && bun run coverage:check && bun run dead-code && bun run build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "1.79.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10",
    "@happy-dom/global-registrator": "21.0.4",
    "@playwright/test": "1.65.1",
    "@stylistic/eslint-plugin": "6.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.14.0",
    "knip": "6.48.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8"
  }
}
